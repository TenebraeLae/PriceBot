[Unit]
Description=PriceBot Docker Compose
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pricebot
NoNewPrivileges=yes
PrivateTmp=yes
# Секреты только в /opt/pricebot/.env (права 0600), не в unit Environment=
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
