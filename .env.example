# Токен Telegram-бота (не коммитить настоящий)
BOT_TOKEN=0000000000:dummy-token-for-local-dev

# Публичный URL Mini App
WEBAPP_URL=http://localhost:8080/app/

# Админы: telegram_id через запятую
ADMIN_IDS=111111111,222222222

# PostgreSQL (SQLAlchemy asyncpg)
DATABASE_URL=postgresql+asyncpg://pricebot:pricebot@localhost:5432/pricebot

# Redis (кэш поиска / rate limit)
REDIS_URL=redis://localhost:6379/0

# Календарь статусов и номеров заказа
TIMEZONE=Europe/Moscow

# Пагинация: бот / Mini App
PAGE_SIZE=10
PAGE_SIZE_WEB=20

# Потолок строк импорта Excel (без заголовка)
MAX_IMPORT_ROWS=50000

# Провайдер оплаты: fake | yookassa
PAYMENT_PROVIDER=fake

# Секрет платёжного webhook (HMAC только для fake; не совпадает с Telegram)
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook

# ЮKassa (заполнять только при PAYMENT_PROVIDER=yookassa). Плейсхолдеры, не ключи.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Пусто = {PUBLIC_BASE_URL}/app/
YOOKASSA_RETURN_URL=
# Пусто = официальные сети ЮKassa. * = не проверять IP (локально).
YOOKASSA_TRUSTED_IPS=

# Секрет webhook Telegram (другой, не платёжный)
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook

# Массовые платные рассылки в v1 выключены
ALLOW_PAID_BROADCAST=false

# Локально polling; в Docker/проде webhook
BOT_MODE=polling
PUBLIC_BASE_URL=http://localhost:8080

# Bothost / addon: localhost в DATABASE_URL/REDIS_URL/WEBAPP_URL заменяется
DOMAIN=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# HTTP API
HOST=0.0.0.0
PORT=8080

# Каталоги на диске
MEDIA_DIR=data/media
IMPORTS_DIR=data/imports
BACKUPS_DIR=data/backups
BACKUP_RETENTION_DAYS=7
